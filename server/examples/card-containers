#!/usr/bin/env bash
# card-containers DIR: writes DIR/containers.json, a reference-server card with how many Docker containers run.
# Run it as root from cron (the docker group is root-equivalent, so the server itself shouldn't have it):
#   */5 * * * * root /usr/local/bin/card-containers /var/lib/homelab-companion/cards
set -euo pipefail
dir=${1:?usage: card-containers DIR}
up=$(docker ps -q | wc -l)
all=$(docker ps -aq | wc -l)
unhealthy=$(docker ps --filter health=unhealthy -q | wc -l)
tint=green
[ "$up" -lt "$all" ] && tint=orange
[ "$unhealthy" -gt 0 ] && tint=red
tmp=$(mktemp "$dir/.containers.XXXXXX")
printf '{"id":"containers","title":"Containers","icon":"shippingbox","tint":"%s","style":"metrics","updated":"%s","items":[{"title":"Running","value":"%s/%s"},{"title":"Unhealthy","value":"%s"}]}\n' \
  "$tint" "$(date +%H:%M)" "$up" "$all" "$unhealthy" >"$tmp"
chmod 644 "$tmp"
mv "$tmp" "$dir/containers.json"
