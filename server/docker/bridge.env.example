# Env for the bridge container (server/compose.yaml). Copy it to docker/bridge.env and chmod 600 it.
# Never commit the real file. The values never show in the bridge's answers or log.

# The keys of your sources, under the names that their `key_env` (or other `*_env`) in docker/config.json gives:
# LAB_KEY=

# Optional: bearer tokens (16+ random characters, comma-separated) for devices without a Tailscale login header
# (tagged devices, curl). The app on your phone needs none.
# HOMELAB_TOKENS=

# Optional: a fixed secret for signed action buttons (else a new one at every start). Only with actions.
# HOMELAB_BUTTON_SECRET=
