# Env for the Tailscale sidecar (server/compose.yaml). Copy it to docker/tailscale.env and chmod 600 it.
# An auth key from the admin console (Settings -> Keys -> Generate auth key): not reusable, not ephemeral, and
# pre-approved if your tailnet approves devices. It is read once, at the first start; the login then stays in the
# tailscale-state volume, and you can delete the key from this file.
TS_AUTHKEY=tskey-auth-replace-me
