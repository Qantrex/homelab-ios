{"actions": [
  {"name": "todo-add", "label": "Add a to-do", "icon": "checklist", "hint": "Goes to the Home Assistant list; with a time the phone reminds you.",
   "fields": [{"name": "summary", "label": "To-do", "kind": "text", "max": 120, "required": true},
              {"name": "due", "label": "Due", "kind": "date-or-datetime", "max": 25, "required": false,
               "hidden_when": {"list": ["shopping"]}},
              {"name": "description", "label": "Notes", "kind": "multiline", "max": 300, "required": false},
              {"name": "list", "label": "List", "kind": "choice", "max": 10, "required": false,
               "options": [{"value": "todo", "label": "To-dos"}, {"value": "shopping", "label": "Shopping"}]}]},
  {"name": "todo-done", "label": "Tick off a to-do", "icon": "checkmark.circle", "hint": "The item's text exactly as the list shows it.", "start": false,
   "fields": [{"name": "item", "label": "Item", "kind": "text", "max": 120, "required": true},
              {"name": "list", "label": "List", "kind": "choice", "max": 10, "required": false,
               "options": [{"value": "todo", "label": "To-dos"}, {"value": "shopping", "label": "Shopping"}]},
              {"name": "uid", "label": "uid", "kind": "text", "max": 200, "required": false, "hidden": true}]},
  {"name": "parcel-done", "label": "Parcel delivered", "icon": "shippingbox", "hint": "Marks the parcel as delivered.", "start": false,
   "fields": [], "arg": [{"label": "Parcel", "parts": [{"kind": "word", "label": "Parcel"}]}]},
  {"name": "calendar-add", "label": "Add an event", "icon": "calendar.badge.plus", "hint": "Always goes to the Privat calendar. A day without a time is all day.",
   "fields": [{"name": "title", "label": "Title", "kind": "text", "max": 120, "required": true},
              {"name": "start", "label": "Start", "kind": "date-or-datetime", "max": 25, "required": true},
              {"name": "end", "label": "End", "kind": "date-or-datetime", "max": 25, "required": false},
              {"name": "duration_min", "label": "Minutes", "kind": "number", "max": 4, "required": false},
              {"name": "location", "label": "Place", "kind": "text", "max": 200, "required": false},
              {"name": "notes", "label": "Notes", "kind": "multiline", "max": 1000, "required": false}]},
  {"name": "wake-set", "label": "Wake-up", "icon": "alarm", "hint": "One day only; it replaces the school-day wake-up on that day.", "fields": [],
   "arg": [{"label": "Wake me", "parts": [{"kind": "date", "label": "Day"}, {"kind": "literal", "text": "T"}, {"kind": "time", "label": "Time"}]},
           {"label": "No wake-up", "parts": [{"kind": "date", "label": "Day"}, {"kind": "literal", "text": ":off"}]},
           {"label": "Normal", "parts": [{"kind": "date", "label": "Day"}, {"kind": "literal", "text": ":clear"}]}]},
  {"name": "commute-mode", "label": "Bike or U6", "icon": "bicycle", "fields": [],
   "arg": [{"label": "Way", "parts": [{"kind": "date", "label": "Day"}, {"kind": "literal", "text": ":"},
                                      {"kind": "choice", "label": "Way", "options": [{"value": "bike", "label": "Duke"}, {"value": "u6", "label": "U6"}]}]}]},
  {"name": "ha-control", "label": "Living room", "icon": "lightbulb", "fields": [],
   "arg": [{"label": "Switch", "parts": [{"kind": "choice", "label": "What", "options": [
     {"value": "lamps-on", "label": "Lamps on"}, {"value": "lamps-dim", "label": "Lamps dimmed"}, {"value": "lamps-off", "label": "Lamps off"},
     {"value": "tv-on", "label": "TV on"}, {"value": "tv-off", "label": "TV off"}]}]}]},
  {"name": "restart-container", "label": "Restart a container", "icon": "arrow.clockwise", "destructive": true,
   "hint": "Only containers on the host's restart list.", "fields": [],
   "arg": [{"label": "Container", "parts": [{"kind": "choice", "label": "Host", "options": [{"value": "nas", "label": "nas"}, {"value": "pi", "label": "pi"},
                                                                                     {"value": "server", "label": "server"}, {"value": "media", "label": "media"}]},
                                            {"kind": "literal", "text": ":"}, {"kind": "word", "label": "Container"}]}]}
]}
