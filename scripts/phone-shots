#!/usr/bin/env bash
# Usage: scripts/phone-shots [--no-install] [--reset] [OUT_DIR]   (default OUT_DIR: shots-phone/)
# Your own servers, tokens and settings stay: the shots only add the demo servers and take them away again at the end.
# --reset starts from a clean app (-HomelabResetState YES) and so DELETES your servers and Home Assistant token; then
# set HOMELAB_SERVER=<your Homelab API URL> (and HOMELAB_PINS=light.a,script.b) to get the server back at the end.
# The shots do change Today's density and personality and set them to Standard/Off at the end.
# Screenshots from a real iPhone over USB, from Linux: builds and installs the app (xtool dev), launches it in demo
# mode on every tab and saves a PNG per tab. About 2 minutes, instead of ~25 for the CI simulator run.
# Needs once: the iPhone plugged in, unlocked (Auto-Lock off while testing), trusted, Developer Mode on, usbmuxd
# running, `xtool auth login`. The developer disk image is mounted automatically. No root: pymobiledevice3 talks to
# iOS 17+ through its userspace tunnel. It lives in .venv/ (created on the first run).
# WAIT (default 4) is the time from launch to screenshot, FIRST_WAIT (default 8) the same for the first, reset shot.
# The phone keeps its own appearance and text size; CI covers dark/light, XXL text and other screen sizes.
set -euo pipefail
cd "$(dirname "$0")/.."

install=1
reset=0
while [ $# -gt 0 ]; do
  case $1 in
    --no-install) install=0; shift ;;
    --reset) reset=1; shift ;;
    *) break ;;
  esac
done
OUT=${1:-shots-phone}
PMD_VERSION=11.50.0
WAIT=${WAIT:-4}               # seconds from launch to screenshot
FIRST_WAIT=${FIRST_WAIT:-8}   # the first (reset) shot: a fresh debug build needs longer for its first data

if [ ! -x .venv/bin/pymobiledevice3 ]; then
  python3 -m venv .venv
  .venv/bin/pip install -q "pymobiledevice3==$PMD_VERSION"
fi
pmd() { timeout 120 .venv/bin/pymobiledevice3 "$@"; }

idevice_id -l | grep -q . || { echo "no iPhone found: plug it in, unlock it, and check that usbmuxd runs"; exit 1; }

if [ "$install" = 1 ]; then
  echo "== build + install (xtool dev)"
  # xtool up to 1.24.0 drops the App Group for a free Apple ID: the widgets never see the app's data (docs/SETUP.md).
  v=$(xtool --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true)
  if [ -n "$v" ] && [ "$(printf '%s\n' "$v" 1.24.0 | sort -V | tail -1)" = 1.24.0 ]; then
    echo "WARN: xtool $v drops the App Group for a free Apple ID: the widgets will say 'No App Group'. See docs/SETUP.md"
  fi
  # `xtool dev run` keeps running after the install (it waits on the launched app), and `xtool install` hung at
  # "Packaging" (2026-11-05). So: run it in its own process group, stop it once the install reached 100%.
  log=$(mktemp)
  setsid xtool dev run --usb < /dev/null > "$log" 2>&1 &
  pid=$!
  installed=0
  for _ in $(seq 1 400); do
    if tr '\r' '\n' < "$log" | grep -q '\[Installing\] 100%'; then installed=1; sleep 3; break; fi
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
  done
  kill -- "-$pid" 2>/dev/null || true
  wait "$pid" 2>/dev/null || true
  # Only "[Installing] 100%" is an install: xtool also prints "Installing to device" before it stops at
  # "[Provisioning]" (2026-11-06).
  if [ "$installed" = 0 ]; then
    clean=$(tr '\r' '\n' < "$log" | sed 's/\x1b\[[0-9;]*[A-Za-z]//g')
    rm -f "$log"
    if grep -q 'must be revoked' <<< "$clean"; then
      echo "xtool needs to revoke a certificate: run \`xtool dev run --usb\` once yourself and confirm, then \`scripts/phone-shots --no-install\`"
      echo "install failed"; exit 1
    fi
    # The compiler's errors with their source lines (not the long command lines); else the end of the log
    # without the progress lines.
    errors=$(grep -E 'error: ' -A3 <<< "$clean" | grep -vE 'Failed frontend|swift-frontend|Command line' | head -30 || true)
    if [ -n "$errors" ]; then
      echo "$errors"
    else
      grep -vE '^[[:space:]]*$|[0-9]+(\.[0-9]+)?%[[:space:]]*$' <<< "$clean" | tail -20 || true
    fi
    echo "install failed"; exit 1
  fi
  rm -f "$log"
  echo "installed"
fi

# xtool installs under a team prefix for free accounts (XTL-<TEAM>.com.qantrex.homelab): look the ID up.
# On a phone where SideStore installed the app, use --no-install (an xtool install would add a second app).
# SideStore installs it as com.qantrex.homelab.<TEAM>: both forms count, the extensions don't.
bundle=$(pmd apps list -t User 2>/dev/null | grep -oE '"CFBundleIdentifier": "[^"]*com\.qantrex\.homelab(\.[A-Z0-9]+)?"' \
  | grep -vE 'Homelab(Widget|Share)' | head -1 | sed -E 's/.*: "(.*)"/\1/')
[ -n "$bundle" ] || { echo "Homelab is not installed on the phone"; exit 1; }
echo "== app: $bundle"

pmd mounter auto-mount >/dev/null 2>&1 || true   # fails harmlessly when already mounted

mkdir -p "$OUT"
rm -f "$OUT"/*.png
n=0
wait_s=$FIRST_WAIT
shot() {   # shot NAME LAUNCH_ARGS...
  local name=$1; shift
  n=$((n + 1))
  local file
  file=$(printf '%s/%02d-%s.png' "$OUT" "$n" "$name")
  local try
  for try in 1 2; do   # right after an install the first launch sometimes fails; once more after a pause
    if pmd developer dvt launch --userspace "$bundle $*" >/dev/null 2>&1; then
      sleep "$wait_s"
      if pmd developer dvt screenshot --userspace "$file" >/dev/null 2>&1; then echo "ok   $file"; return; fi
    fi
    [ "$try" = 1 ] && sleep 3
  done
  echo "FAIL $file (is the phone unlocked?)"
}

if [ "$reset" = 1 ]; then
  shot demo-today -HomelabResetState YES -HomelabDemo YES -HomelabTab today
else
  shot demo-today -HomelabDemo YES -HomelabTab today
fi
wait_s=$WAIT
for tab in actions chat lab settings; do
  shot "demo-$tab" -HomelabDemo YES -HomelabTab "$tab"
done
shot demo-form-wake  -HomelabDemo YES -HomelabTab actions -HomelabAction wake-set
shot demo-form-todo  -HomelabDemo YES -HomelabTab actions -HomelabAction todo-add
shot demo-host-media -HomelabDemo YES -HomelabDemoScene problem -HomelabTab lab -HomelabHost media
shot demo-today-problem -HomelabDemo YES -HomelabDemoScene problem -HomelabTab today
shot demo-today-overkill -HomelabDemo YES -HomelabTab today -HomelabDensity overkill
shot demo-today-calm     -HomelabDemo YES -HomelabTab today -HomelabDensity calm
shot demo-today-snarky   -HomelabDemo YES -HomelabTab today -HomelabPersonality snarky
shot demo-deals-today    -HomelabDemo YES -HomelabTab today -HomelabDensity standard -HomelabPersonality off
shot demo-deals-actions  -HomelabDemo YES -HomelabTab actions
shot demo-deals-list     -HomelabDemo YES -HomelabDeals list
shot demo-deals-detail   -HomelabDemo YES -HomelabDeals detail
# Leave the phone as it was.
shot demo-today-standard -HomelabDemo YES -HomelabTab today -HomelabDensity standard -HomelabPersonality off
# Back to the owner's real server: the demo servers go away again (they were added by -HomelabDemo YES).
back="-HomelabDemo NO -HomelabTab today"
[ -n "${HOMELAB_SERVER:-}" ] && back="$back -HomelabServer $HOMELAB_SERVER"
[ -n "${HOMELAB_PINS:-}" ] && back="$back -HomelabPins $HOMELAB_PINS"
pmd developer dvt launch --userspace "$bundle $back" >/dev/null 2>&1 || true
if [ "$reset" = 1 ] && [ -z "${HOMELAB_SERVER:-}" ]; then
  echo "NOTE: --reset deleted your servers; add them again in Settings (or rerun with HOMELAB_SERVER=…)"
fi
echo "== done: $OUT/"
