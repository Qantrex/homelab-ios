#!/usr/bin/env bash
# Usage: scripts/sim-smoke APP_PATH OUT_DIR
#        scripts/sim-smoke --matrix APP_PATH OUT_DIR   the screenshot matrix instead (see below), about 90 shots
#        scripts/sim-smoke --pick [main|small]     print a simulator UDID and exit (CI uses it for xcodebuild test)
#   APP_PATH  simulator build of the app (e.g. from `xtool dev build --triple arm64-apple-ios-simulator`)
#   OUT_DIR   where the PNG screenshots, app-log.txt, server-log.txt and summary.txt go
# macOS only. Boots the newest iPhone simulator, installs the app, starts the fixture server
# (server/reference_server.py on 127.0.0.1:8791, the simulator shares the host network) and takes, numbered in order:
#   01-15  demo mode (the calm day), every tab (today actions chat lab settings) in light, dark and accessibility-XL text
#   16-21  live mode against the fixture server: problem, tomorrow, chat, pending (actions), huge, ok
#   22     offline: the fixture server is stopped, the app relaunches with its cached data (error bar + age)
#   23-24  the smallest iPhone available (SE / "e" model / smallest screen): demo today + actions
#   25-26  action forms (demo, reset first): Wake-up in dark, Add an event with accessibility-XL text (-HomelabAction)
#   27     demo host detail (reset first, problem scene) in dark: 24 h sparklines and containers with Restart (-HomelabHost media)
#   28     demo Today (reset first, problem scene) in Detailed with the Snarky personality
#   29     demo Today with only the demo Home Assistant (reset first, -HomelabDemoScene ha-only): no Companion server
#   30-35  first run (reset first): the welcome, and Found with "Start with" over the demo (-HomelabFirstRun), in light,
#          dark and accessibility-XL text
#   36-37  demo Today with show rules (Deals, Cards, Last report in the evenings) at 14:00 (hidden) and 19:00 (shown)
# Exits 0 when the core shots (01-05, demo light) worked; every other failed shot is reported, not fatal.
#
# --matrix (docs/CI.md "Screenshot matrix"): no fixture server, only demo scenes. Scenes demo, ha-only, bridge, problem, minimal
# and first-run x every detail level (Density, read from Sources/HomelabKit/TodayLayout.swift) x the voices off, dry,
# snarky, ultrakill. Every pair of (scene, detail, voice) is covered: each scene x detail pair is shot once and the voice
# is picked by a Latin square, so each scene x voice and each detail x voice pair appears too. Names:
#   <scene>-<density>-<personality>-<tab>[-ax][-light].png     (first-run: tab is welcome or found)
#   Today and Lab for every combination; Actions, Chat, Settings (and Settings > Advanced, once the app has
#   -HomelabSettingsPage) for two combinations per scene; Today, Lab and Settings at the largest accessibility text
#   size (-ax) and Today and Lab in light mode (-light) for one combination per scene. Default look: dark, large text.
# index.txt lists what each shot shows. Failed shots are listed in summary.txt; the exit code is 1 when any failed (a
# crash is a finding), 0 otherwise. No push anywhere: CI uploads OUT_DIR as the artifact matrix-<runner>.
# Env: WAIT (seconds after each launch, default 6), PORT (default 8791), KEEP_SIM=1 leaves the simulators booted.
set -euo pipefail

usage() { awk '/^set -/ { exit } NR > 1' "$0"; exit 2; }
[ "$(uname)" = Darwin ] || { echo "sim-smoke: macOS only"; exit 2; }
MATRIX=0
if [ "${1:-}" = --matrix ]; then MATRIX=1; shift; fi

# pick_udid main|small [EXCLUDE_UDID]
#   main:  the newest plain numbered iPhone ("iPhone 17 Pro"): preview images also ship odd form factors (foldables)
#          that boot slowly or not at all. Falls back to any iPhone.
#   small: the iPhone with the narrowest screen (from the device type's profile.plist), newest runtime first;
#          by name (SE, "e" models, mini) when the profile can't be read.
pick_udid() {
  xcrun simctl list -j | python3 -c '
import json, os, plistlib, re, sys
mode, exclude = sys.argv[1], (sys.argv[2] if len(sys.argv) > 2 else "")
d = json.load(sys.stdin)
devices = d["devices"]
types = {t["identifier"]: t for t in d.get("devicetypes", [])}
def version(k):
    try: return [int(x) for x in k.rsplit("iOS-", 1)[1].split("-")]
    except Exception: return [0]
runtimes = sorted((k for k in devices if "iOS" in k), key=version, reverse=True)
def available(k):
    return [x for x in devices[k] if x.get("isAvailable", True) and x["name"].startswith("iPhone") and x["udid"] != exclude]
if mode == "main":
    for pattern in (r"^iPhone \d+( Pro)?$", r"^iPhone"):
        for k in runtimes:
            for dev in available(k):
                if re.match(pattern, dev["name"]):
                    print(dev["udid"]); sys.exit()
    sys.exit()
def size(dev):
    t = types.get(dev.get("deviceTypeIdentifier", ""), {})
    try:
        with open(os.path.join(t["bundlePath"], "Contents", "Resources", "profile.plist"), "rb") as fh:
            p = plistlib.load(fh)
        scale = float(p.get("mainScreenScale", 1)) or 1
        return (float(p["mainScreenWidth"]) / scale, float(p["mainScreenHeight"]) / scale)
    except Exception:
        name = dev["name"]
        if "SE" in name: return (320.0, 568.0)
        if "mini" in name: return (375.0, 812.0)
        if re.search(r"\d+e$", name): return (390.0, 844.0)
        return (999.0, 999.0)
# Foldable or two-screen models (Xcode 27 has an "iPhone Duo") have more than one display and simctl screenshots fail
# there; the narrowest standard iPhone is what the small shots are for.
odd = re.compile(r"Duo|Fold|Flip", re.I)
for k in runtimes:
    devs = [x for x in available(k) if not odd.search(x["name"])]
    if devs:
        best = min(devs, key=lambda x: (size(x), x["name"]))
        print(best["udid"]); sys.exit()
' "$@"
}

if [ "${1:-}" = --pick ]; then
  pick_udid "${2:-main}"
  exit 0
fi
[ $# -eq 2 ] || usage

APP_PATH=$(cd "$(dirname "$1")" && pwd)/$(basename "$1")
mkdir -p "$2"
OUT_DIR=$(cd "$2" && pwd)
touch "$OUT_DIR/.started"   # crash reports newer than this belong to this run
cd "$(dirname "$0")/.."

BUNDLE_ID=com.qantrex.homelab
WAIT=${WAIT:-6}
PORT=${PORT:-8791}
SERVER_URL="http://127.0.0.1:$PORT"
[ -d "$APP_PATH" ] || { echo "sim-smoke: no app at $APP_PATH"; exit 1; }

udid=$(pick_udid main)
[ -n "$udid" ] || { echo "sim-smoke: no available iPhone simulator"; exit 1; }
sim_name() { xcrun simctl list devices | grep "$1" | sed 's/ *(.*//' | xargs; }
echo "simulator: $udid ($(sim_name "$udid"))"

server_pid=""
booted=()
stop_server() {
  if [ -n "$server_pid" ]; then kill "$server_pid" 2>/dev/null || true; wait "$server_pid" 2>/dev/null || true; fi
  server_pid=""
}
cleanup() {
  stop_server
  if [ "${KEEP_SIM:-0}" != 1 ]; then
    for u in "${booted[@]+"${booted[@]}"}"; do xcrun simctl shutdown "$u" 2>/dev/null || true; done
  fi
}
trap cleanup EXIT

# prepare UDID: boot, fixed status bar, light mode, normal text, install the app
prepare() {
  local u=$1
  xcrun simctl boot "$u" 2>/dev/null || true   # "already booted" is fine
  booted+=("$u")
  xcrun simctl bootstatus "$u" -b
  xcrun simctl status_bar "$u" override --time 9:41 --batteryState charged --batteryLevel 100 \
    --wifiBars 3 --cellularBars 4 || echo "WARN: status bar override failed"
  xcrun simctl ui "$u" appearance light || true
  xcrun simctl ui "$u" content_size large || true
  xcrun simctl install "$u" "$APP_PATH"
}

start_time=$(date '+%Y-%m-%d %H:%M:%S')
prepare "$udid"

# Fixture server, starting in the "problem" state; /__control switches it later. (Not for the matrix: demo scenes only.)
if [ "$MATRIX" = 1 ]; then
  :
elif [ -f server/reference_server.py ]; then
  # state-tomorrow.json is "tomorrow" only on one day: a copy of the fixtures with the card dates moved to tomorrow.
  FIXTURES="$OUT_DIR/fixtures"
  rm -rf "$FIXTURES"; cp -R Sources/HomelabKit/Fixtures "$FIXTURES"
  tomorrow=$(date -v+1d +%F 2>/dev/null || date -d tomorrow +%F)
  sed -i.bak "s/\"date\": \"2026-11-05\"/\"date\": \"$tomorrow\"/" "$FIXTURES/state-tomorrow.json" && rm -f "$FIXTURES/state-tomorrow.json.bak"
  # The rewrite must have worked, or shot 17 shows an old card; fail loudly (a fixture edit that moves the date breaks it).
  grep -q "\"date\": \"$tomorrow\"" "$FIXTURES/state-tomorrow.json" \
    || { echo "sim-smoke: state-tomorrow.json has no \"date\": \"$tomorrow\" after the rewrite (did the fixture's date change from 2026-11-05?)" >&2; exit 1; }
  python3 server/reference_server.py --fixtures "$FIXTURES" --port "$PORT" \
    --state state-problem.json > "$OUT_DIR/server-log.txt" 2>&1 &
  server_pid=$!
  for _ in $(seq 1 50); do
    curl -s -o /dev/null --max-time 1 "$SERVER_URL/" && break
    sleep 0.2
  done
  curl -s -o /dev/null --max-time 1 "$SERVER_URL/" || echo "WARN: fixture server not answering on $SERVER_URL"
else
  echo "WARN: server/reference_server.py missing, live-mode shots will show an unreachable server"
fi

ok=()
failed=()
dev=$udid   # the simulator the helpers below act on
n=0         # the last screenshot number
fail() { failed+=("$1"); echo "FAIL $1"; }
launch() { xcrun simctl launch --terminate-running-process "$dev" "$BUNDLE_ID" "$@" >/dev/null; }
# app_running: is the app process alive in the simulator? (A crash leaves the home screen, which would still
# screenshot fine; that must count as a failure, not a success.)
# The list is read into a variable first: `launchctl list | grep -q` under pipefail fails at random, because grep -q
# exits at the first match and launchctl then dies of SIGPIPE (141). That made good shots "NOT-RUNNING" (2026-11-05).
# One retry after a second covers a launch that is still settling.
app_running() {
  local list try
  for try in 1 2; do
    list=$(xcrun simctl spawn "$dev" launchctl list 2>/dev/null || true)
    grep -qF "UIKitApplication:$BUNDLE_ID" <<<"$list" && return 0
    [ "$try" = 1 ] && sleep 1
  done
  return 1
}
# shot NAME: the next number + NAME
shot() {
  n=$((n + 1))
  local name
  name=$(printf '%02d-%s' "$n" "$1")
  if ! app_running; then
    xcrun simctl io "$dev" screenshot "$OUT_DIR/$name-NOT-RUNNING.png" >/dev/null 2>&1 || true
    fail "$name (app not running: crashed or closed)"
    return
  fi
  if xcrun simctl io "$dev" screenshot "$OUT_DIR/$name.png" >/dev/null 2>&1; then
    ok+=("$name"); echo "ok   $name"
  else
    fail "$name"
  fi
}
# scene NAME LAUNCH_ARGS... : launch fresh, wait, screenshot
scene() {
  local name=$1; shift
  if launch "$@"; then
    sleep "$WAIT"; shot "$name"
  else
    n=$((n + 1)); fail "$(printf '%02d-%s' "$n" "$name") (launch)"
  fi
}
# control STATE_FILE: switch the fixture server's /state answer
control() { curl -fsS -o /dev/null --max-time 3 "$SERVER_URL/__control?state=$1"; }

# --matrix: everything below the helpers is replaced by the matrix run (matrix_run, defined here, ends the script).
matrix_plan() {   # prints one TSV line per shot: name, tab, look (dark|ax|light), launch arguments, description
  python3 - "$MATRIX_ADVANCED" <<'PY'
import re, sys
advanced = sys.argv[1] == "1"
defaults = ["calm", "standard", "overkill"]
try:
    src = open("Sources/HomelabKit/TodayLayout.swift").read()
    body = re.search(r"enum Density\b[^{]*\{(.*?)\n    public var id", src, re.S).group(1)
    densities = []
    for line in body.splitlines():
        line = line.split("//")[0].strip()
        if line.startswith("case "):
            densities += [x.split("=")[0].strip() for x in line[5:].split(",") if x.strip()]
except Exception:
    densities = []
if not densities:
    print("WARN: Density cases not found in TodayLayout.swift, using " + ",".join(defaults), file=sys.stderr)
    densities = defaults
voices = ["off", "dry", "snarky", "ultrakill"]
scenes = [("demo", "the calm demo day", ["-HomelabDemoScene", "calm"]),
          ("ha-only", "only the demo Home Assistant", ["-HomelabDemoScene", "ha-only"]),
          ("bridge", "the neutral Bridge homelab", ["-HomelabDemoScene", "bridge"]),
          ("problem", "the demo problem scene", ["-HomelabDemoScene", "problem"]),
          ("minimal", "a server that sends only /info and /state", ["-HomelabDemoScene", "minimal"]),
          ("first-run", "the first run", None)]
shots, names = [], set()
def add(si, di, tab, look=""):
    scene, what, extra = scenes[si]
    d, v = densities[di % len(densities)], voices[(si + di) % len(voices)]
    name = "-".join([scene, d, v, tab]) + {"": "", "ax": "-ax", "light": "-light"}[look]
    assert name not in names, name
    names.add(name)
    if scene == "first-run":   # the welcome after a reset; Found with "Start with" over the demo servers
        args = ["-HomelabResetState", "YES"] + (["-HomelabDemo", "YES", "-HomelabFirstRun", "YES"] if tab == "found" else [])
    else:
        args = ["-HomelabResetState", "YES", "-HomelabDemo", "YES"] + extra
    args += ["-HomelabDensity", d, "-HomelabPersonality", v]
    if scene != "first-run":
        args += ["-HomelabTab", "settings" if tab.startswith("settings") else tab]
    if tab == "settings-advanced":
        args += ["-HomelabSettingsPage", "advanced"]
    size = {"": "default text size", "ax": "largest accessibility text size", "light": "default text size"}[look]
    title = {"today": "Today", "lab": "Lab", "actions": "Actions", "chat": "Chat", "settings": "Settings",
             "settings-advanced": "Settings > Advanced", "welcome": "The welcome", "found": "Found, with Start with"}[tab]
    desc = "%s, %s, detail %s, voice %s, %s, %s" % (title, what, d, v, "light" if look == "light" else "dark", size)
    shots.append((name, tab, look or "dark", " ".join(args), desc))
D = len(densities)
for si, (scene, _, _) in enumerate(scenes):
    tabs = ["welcome", "found"] if scene == "first-run" else ["today", "lab"]
    for di in range(D):               # every scene x detail pair once; the voice follows the Latin square
        for t in tabs: add(si, di, t)
extra_tabs = ["actions", "chat", "settings"] + (["settings-advanced"] if advanced else [])
for si in range(len(scenes) - 1):   # every scene but first-run
    for di in (si, si + 1):           # two combinations per scene for the other tabs
        for t in extra_tabs: add(si, di, t)
    for t in ("today", "lab", "settings"): add(si, si + 2, t, "ax")
    for t in ("today", "lab"): add(si, si + 3, t, "light")
FR = len(scenes) - 1
add(FR, 2, "welcome", "ax")
add(FR, 3, "welcome", "light"); add(FR, 3, "found", "light")
shots.sort(key=lambda s: {"dark": 0, "ax": 1, "light": 2}[s[2]])   # stable: fewer appearance switches
for s in shots: print("\t".join(s))
PY
}

matrix_run() {
  MATRIX_ADVANCED=0
  grep -q HomelabSettingsPage Sources/HomelabKit/AppModel.swift 2>/dev/null && MATRIX_ADVANCED=1
  local plan="$OUT_DIR/.plan.tsv"
  matrix_plan > "$plan"
  [ -s "$plan" ] || { echo "sim-smoke: empty matrix plan"; exit 1; }
  echo "matrix: $(wc -l < "$plan" | tr -d ' ') shots planned (Settings > Advanced: $([ "$MATRIX_ADVANCED" = 1 ] && echo yes || echo "no, the app has no -HomelabSettingsPage yet"))"
  : > "$OUT_DIR/index.txt"
  local look="" name tab want args desc
  while IFS=$'\t' read -r name tab want args desc; do
    if [ "$want" != "$look" ]; then
      look=$want
      case $look in
        dark)  xcrun simctl ui "$dev" appearance dark || true;  xcrun simctl ui "$dev" content_size large || true ;;
        ax)    xcrun simctl ui "$dev" appearance dark || true;  xcrun simctl ui "$dev" content_size accessibility-extra-extra-extra-large || true ;;
        light) xcrun simctl ui "$dev" appearance light || true; xcrun simctl ui "$dev" content_size large || true ;;
      esac
    fi
    # shellcheck disable=SC2086   # $args is words without spaces, made by matrix_plan
    if launch $args; then
      sleep "$WAIT"
      if ! app_running; then
        xcrun simctl io "$dev" screenshot "$OUT_DIR/$name-NOT-RUNNING.png" >/dev/null 2>&1 || true
        fail "$name (app not running: crashed or closed)"
      elif xcrun simctl io "$dev" screenshot "$OUT_DIR/$name.png" >/dev/null 2>&1; then
        ok+=("$name"); echo "ok   $name"
        printf '%s.png\t%s\n' "$name" "$desc" >> "$OUT_DIR/index.txt"
      else
        fail "$name"
      fi
    else
      fail "$name (launch)"
    fi
  done < "$plan"
  rm -f "$plan"
  xcrun simctl ui "$dev" appearance light || true
  xcrun simctl ui "$dev" content_size large || true
  xcrun simctl spawn "$udid" log show --start "$start_time" --predicate "subsystem == \"$BUNDLE_ID\"" \
    --style compact > "$OUT_DIR/app-log.txt" 2>&1 || true
  mkdir -p "$OUT_DIR/crashes"
  find "$HOME/Library/Logs/DiagnosticReports" -newer "$OUT_DIR/.started" -name 'Homelab*' -exec cp {} "$OUT_DIR/crashes/" \; 2>/dev/null || true
  local crashes
  crashes=$(find "$OUT_DIR/crashes" -type f | wc -l | tr -d ' ')
  [ "$crashes" = 0 ] && rmdir "$OUT_DIR/crashes" 2>/dev/null
  {
    echo "sim-smoke --matrix: ${#ok[@]} screenshots ok, ${#failed[@]} failed, $crashes crash reports"
    echo "simulator: $(sim_name "$udid")"
    for s in "${failed[@]+"${failed[@]}"}"; do echo "  failed: $s"; done
    echo "what each shot shows: index.txt"
  } | tee "$OUT_DIR/summary.txt"
  if [ -n "${ok[0]+x}" ] && [ "${#failed[@]}" = 0 ] && [ "$crashes" = 0 ]; then exit 0; fi
  exit 1
}
if [ "$MATRIX" = 1 ]; then matrix_run; fi

TABS=(today actions chat lab settings)
DEMO=(-HomelabDemo YES)
LIVE=(-HomelabResetState YES -HomelabServer "$SERVER_URL")
# After the live and offline shots: a clean demo, without the fixture server and its cache from 16-22.
FRESH_DEMO=(-HomelabResetState YES -HomelabDemo YES)
# The demo's stress scene (an unhealthy and an exited container, a warning, U6 delays) instead of its calm day.
PROBLEM=(-HomelabDemoScene problem)

# 01-15: demo mode, every tab, in light, dark and accessibility-extra-large text
for look in light dark xxl; do
  case $look in
    light) xcrun simctl ui "$dev" appearance light || true; xcrun simctl ui "$dev" content_size large || true ;;
    dark)  xcrun simctl ui "$dev" appearance dark || true ;;
    xxl)   xcrun simctl ui "$dev" appearance light || true
           xcrun simctl ui "$dev" content_size accessibility-extra-large || true ;;
  esac
  for tab in "${TABS[@]}"; do scene "demo-$tab-$look" "${DEMO[@]}" -HomelabTab "$tab"; done
done
xcrun simctl ui "$dev" appearance light || true
xcrun simctl ui "$dev" content_size large || true
core=("${ok[@]+"${ok[@]}"}")   # for the exit code: 01-05 must be among these

# 16-21: live mode against the fixture server
live() {   # live NAME STATE_FILE TAB
  if control "$2"; then
    scene "$1" "${LIVE[@]}" -HomelabTab "$3"
  else
    n=$((n + 1)); fail "$(printf '%02d-%s' "$n" "$1") (/__control $2)"
  fi
}
live live-today-problem    state-problem.json today
live live-today-tomorrow   state-tomorrow.json today
live live-chat             state-problem.json chat
live live-actions-pending  state-pending.json actions
live live-lab-huge         state-huge.json    lab
live live-today-ok         state-ok.json      today

# 22: offline. The app has state-ok cached from 21; stop the server and relaunch it. No -HomelabServer here: that
# argument re-adds the server under a new id and drops its cache, and no reset, so the saved server stays.
stop_server
if launch -HomelabTab today; then
  sleep $((WAIT + 4)); shot live-offline-cached
else
  n=$((n + 1)); fail "$(printf '%02d' "$n")-live-offline-cached (launch)"
fi

# 23-24: the smallest iPhone, demo mode
small=$(pick_udid small "$udid" || true)
if [ -n "$small" ]; then
  echo "small simulator: $small ($(sim_name "$small"))"
  if prepare "$small"; then
    dev=$small
    scene small-demo-today-light    "${DEMO[@]}" -HomelabTab today
    scene small-demo-actions-light  "${DEMO[@]}" -HomelabTab actions
    dev=$udid
  else
    fail "small simulator (boot/install)"
  fi
else
  fail "small simulator (none available)"
fi

# 25-26: forms of actions the app starts (Actions tab, Start), opened with -HomelabAction
xcrun simctl ui "$dev" appearance dark || true
scene demo-form-wake-dark "${FRESH_DEMO[@]}" -HomelabTab actions -HomelabAction wake-set
xcrun simctl ui "$dev" appearance light || true
xcrun simctl ui "$dev" content_size accessibility-extra-large || true
scene demo-form-event-xxl "${FRESH_DEMO[@]}" -HomelabTab actions -HomelabAction calendar-add
xcrun simctl ui "$dev" content_size large || true

# 27: a host's details (Lab), opened with -HomelabHost: sparklines, containers (problems first) and Restart buttons
xcrun simctl ui "$dev" appearance dark || true
scene demo-host-media-dark "${FRESH_DEMO[@]}" "${PROBLEM[@]}" -HomelabTab lab -HomelabHost media
xcrun simctl ui "$dev" appearance light || true

# 28: everything at once, with a personality
scene demo-today-overkill-snarky "${FRESH_DEMO[@]}" "${PROBLEM[@]}" -HomelabTab today -HomelabDensity overkill -HomelabPersonality snarky

# 29: Home Assistant only, no Companion server: the headline from HA's states ("Home.", "1 light on", gold unavailable)
scene demo-ha-only "${FRESH_DEMO[@]}" -HomelabDemoScene ha-only -HomelabTab today
# 30-35: the first run (docs/plans/MODULAR.md, M2.3). The welcome after a reset; Found with "Start with" over the demo
# servers (-HomelabFirstRun only works when every server is a demo one).
FIRST_RUN=(-HomelabResetState YES -HomelabDemo YES -HomelabFirstRun YES)
xcrun simctl ui "$dev" appearance light || true
scene first-run-welcome-light -HomelabResetState YES
scene first-run-found-light "${FIRST_RUN[@]}"
xcrun simctl ui "$dev" appearance dark || true
scene first-run-welcome-dark -HomelabResetState YES
scene first-run-found-dark "${FIRST_RUN[@]}"
xcrun simctl ui "$dev" appearance light || true
xcrun simctl ui "$dev" content_size accessibility-extra-large || true
scene first-run-welcome-xxl -HomelabResetState YES
scene first-run-found-xxl "${FIRST_RUN[@]}"
xcrun simctl ui "$dev" content_size large || true

# 36-37: show rules at a fixed clock time (-HomelabTime): at 14:00 the evening sections are hidden and Today ends with
# "Hidden now: Deals, Cards and Last report (evenings) · Show"; at 19:00 they are back and the line is gone
RULES=(-HomelabRules "deals=evenings,cards=evenings,report=evenings")
scene demo-rule-hidden "${FRESH_DEMO[@]}" "${RULES[@]}" -HomelabTab today -HomelabTime 14:00
scene demo-rule-shown "${FRESH_DEMO[@]}" "${RULES[@]}" -HomelabTab today -HomelabTime 19:00

# App log for this run (Logger subsystem com.qantrex.homelab), from the main simulator
xcrun simctl spawn "$udid" log show --start "$start_time" --predicate "subsystem == \"$BUNDLE_ID\"" \
  --style compact > "$OUT_DIR/app-log.txt" 2>&1 \
  || xcrun simctl spawn "$udid" log show --last 10m --predicate "subsystem == \"$BUNDLE_ID\"" \
       --style compact > "$OUT_DIR/app-log.txt" 2>&1 || true

core_ok=1
i=0
for tab in "${TABS[@]}"; do
  i=$((i + 1))
  grep -qx "$(printf '%02d' "$i")-demo-$tab-light" <<<"$(printf '%s\n' "${core[@]+"${core[@]}"}")" || core_ok=0
done

# Crash reports of the app from this run (simulator crashes land in the host's DiagnosticReports).
mkdir -p "$OUT_DIR/crashes"
find "$HOME/Library/Logs/DiagnosticReports" -newer "$OUT_DIR/.started" -name 'Homelab*' -exec cp {} "$OUT_DIR/crashes/" \; 2>/dev/null || true
crashes=$(find "$OUT_DIR/crashes" -type f | wc -l | tr -d ' ')
[ "$crashes" = 0 ] && rmdir "$OUT_DIR/crashes" 2>/dev/null

{
  echo "sim-smoke: ${#ok[@]} screenshots ok, ${#failed[@]} failed, $crashes crash reports"
  echo "main simulator:  $(sim_name "$udid")"
  if [ -n "${small:-}" ]; then echo "small simulator: $(sim_name "$small")"; fi
  echo "core shots (01-05 demo light): $([ "$core_ok" = 1 ] && echo ok || echo MISSING)"
  for s in "${ok[@]+"${ok[@]}"}"; do echo "  ok:     $s"; done
  for s in "${failed[@]+"${failed[@]}"}"; do echo "  failed: $s"; done
} | tee "$OUT_DIR/summary.txt"

[ "$core_ok" = 1 ]
