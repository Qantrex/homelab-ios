#!/usr/bin/env bash
# Usage: scripts/test-linux
# Runs the Linux-testable part locally, the same as CI job `linux`:
#   1. the fixture server on the host (127.0.0.1:8791), so tests can use HOMELAB_FIXTURE_URL
#   2. `KIT_ONLY=1 swift test` inside the swift:6.4-noble container (host network, repo mounted at /w)
#   3. the Python tests of the reference server, on the host
# Needs docker and python3. Env: PORT (default 8791), SWIFT_IMAGE (default swift:6.4-noble).
set -euo pipefail
cd "$(dirname "$0")/.."

PORT=${PORT:-8791}
SWIFT_IMAGE=${SWIFT_IMAGE:-swift:6.4-noble}
server_pid=""
trap '[ -z "$server_pid" ] || kill "$server_pid" 2>/dev/null || true' EXIT

if [ -f server/reference_server.py ]; then
  python3 server/reference_server.py --fixtures Sources/HomelabKit/Fixtures --port "$PORT" > /dev/null 2>&1 &
  server_pid=$!
  # Wait until it answers (up to 20 s) instead of guessing with a sleep: a slow start made the integration tests fail.
  for _ in $(seq 1 200); do
    (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null && break
    kill -0 "$server_pid" 2>/dev/null || { echo "fixture server died (port $PORT in use?)" >&2; exit 1; }
    sleep 0.1
  done
fi

echo "== swift test (KIT_ONLY=1, $SWIFT_IMAGE)"
# As my own user and with its own build folder: a root-owned .build broke the local xtool builds (2026-11-05).
docker run --rm --network host --user "$(id -u):$(id -g)" -e HOME=/tmp \
  -e KIT_ONLY=1 -e HOMELAB_FIXTURE_URL="http://127.0.0.1:$PORT" -e UPDATE_GOLDENS="${UPDATE_GOLDENS:-}" \
  -v "$PWD":/w -w /w "$SWIFT_IMAGE" swift test --scratch-path .build-linux

if [ -f server/test_reference_server.py ]; then
  echo "== python tests"
  python3 -m unittest -v server/test_reference_server.py
fi

echo "== lint"
scripts/lint
