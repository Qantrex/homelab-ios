#!/usr/bin/env bash
# Usage: scripts/lint
# Cheap source checks that run in CI (job `linux`) and work on any machine with bash + grep.
#   - no print( / NSLog( anywhere in Sources/ (use Logger; tests live in Tests/ and may print)
#   - no os_log/Logger call that interpolates something token-ish (token, secret, password, api key, bearer, authorization)
#   - no try! or fatalError( in Sources/HomelabKit (shared code must not crash the app or the widget)
# A line ending in `// lint:allow` is skipped. Comment lines are skipped.
set -euo pipefail
cd "$(dirname "$0")/.."

fail=0
# grep -rn output is "file:line:text"; drop comment lines and explicit opt-outs.
filter() { grep -vE '^[^:]+:[0-9]+:[[:space:]]*(//|\*|/\*)' | grep -v 'lint:allow' || true; }

check() {
  local what=$1 pattern=$2 dir=$3 flags=${4:-}
  [ -d "$dir" ] || return 0
  local hits
  # shellcheck disable=SC2086 # $flags is intentionally word-split (empty or -i)
  hits=$(grep -rnE $flags --include='*.swift' -- "$pattern" "$dir" | filter || true)
  if [ -n "$hits" ]; then
    echo "lint: $what"
    # shellcheck disable=SC2001
    echo "$hits" | sed 's/^/  /'
    fail=1
  fi
}

check "print( in Sources/ (use Logger)"        '(^|[^A-Za-z0-9_.])print\('  Sources
check "NSLog( in Sources/ (use Logger)"        '(^|[^A-Za-z0-9_.])NSLog\('  Sources
check "token-ish value interpolated into a log call" \
  '(os_log|[Ll]ogger\.[a-z]+|(^|[^A-Za-z0-9_])log\.[a-z]+)\(.*\\\(.*(token|secret|password|api_?key|bearer|authorization)' Sources -i
check "try! in Sources/HomelabKit"             'try!'                       Sources/HomelabKit
check "fatalError( in Sources/HomelabKit"      '(^|[^A-Za-z0-9_])fatalError\(' Sources/HomelabKit

# Int(x) on a Double traps on NaN, infinity and anything past Int's range: a server's 3.4e38 °C killed the app.
# Use Int(clamping:) (Numbers.swift). grep can't see types, so this flags an Int( / Int64( / UInt8( ... whose
# argument looks like a Double: rounding, Double, pow, * or /, time intervals, or a server number's name. The safe
# labelled forms (clamping:, exactly:, bitPattern:, truncatingIfNeeded:) are taken out first.
check_conversions() {
  local dir=$1 hits
  [ -d "$dir" ] || return 0
  hits=$(grep -rnE --include='*.swift' -- '(^|[^A-Za-z0-9_.])U?Int(8|16|32|64)?\(' "$dir" | filter \
    | sed -E 's/U?Int(8|16|32|64)?\((clamping|exactly|bitPattern|truncatingIfNeeded):/safe(/g' \
    | grep -E '(^|[^A-Za-z0-9_.])U?Int(8|16|32|64)?\([^)]*(\.rounded|Double|pow\(|[A-Za-z0-9_)][[:space:]]*[*/][[:space:]]*[A-Za-z0-9_(.]|timeInterval|celsius|temp|progress|load|value|scale|[Pp]ct)' \
    || true)
  if [ -n "$hits" ]; then
    echo "lint: Int( on a Double in $dir (use Int(clamping:), or end the line with // lint:allow)"
    echo "$hits" | sed 's/^/  /'
    fail=1
  fi
}
check_conversions Sources/HomelabKit

# Nothing private in this public repo: a real tailnet name (tailXXXXXX.ts.net; examples use tail1234), and any word
# listed one per line in ~/.config/homelab-ios/private-words (kept outside the repo, so the list itself stays private).
private_hits=$(git grep -nIE 'tail[0-9a-f]{6,}\.ts\.net' -- . ':!scripts/lint' 2>/dev/null || true)
words=${HOMELAB_PRIVATE_WORDS:-$HOME/.config/homelab-ios/private-words}
if [ -f "$words" ] && [ -s "$words" ]; then
  private_hits+=$(git grep -nIiF -f "$words" -- . ':!scripts/lint' 2>/dev/null || true)
fi
if [ -n "$private_hits" ]; then
  echo "lint: private names in the repo (tailnet or a word from $words)"
  echo "$private_hits" | sed 's/^/  /'
  fail=1
fi

if [ "$fail" = 0 ]; then echo "lint: ok"; fi
exit "$fail"
